{
  "manifest_version": 3,
  "name": "Pop Out for Todoist",
  "version": "1.1.1",
  "description": "Pop a Todoist task into an always-on-top window and check it off from there. Not created by, affiliated with, or supported by Todoist.",
  "homepage_url": "https://github.com/matthew-chandler/todoist-firefox-popout",
  "browser_specific_settings": {
    "gecko": {
      "id": "todoist-popout@machandler.com",
      "strict_min_version": "151.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://app.todoist.com/*",
    "https://api.todoist.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.todoist.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Pop Out for Todoist settings",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  }
}
